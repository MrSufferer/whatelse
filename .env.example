# Private local credentials. Copy values into .env, never this file.
RENDER_API_KEY=
# Neon pooled connection for application traffic; retain its TLS parameters.
DATABASE_URL=
# Neon direct (non-pooled) connection for migrations and backup/restore probes.
DATABASE_URL_DIRECT=
# Optional: permits agent-managed Neon project/branch operations.
NEON_API_KEY=
# Generated locally by provision.py and stored in private Render configuration.
SESSION_SECRET=
ACCESS_TOKEN_SECRET=
